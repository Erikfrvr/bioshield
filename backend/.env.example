# Dados do MySQL. No XAMPP (Windows) o usuario root vem sem senha.
# No Linux o root do MySQL nao aceita senha pelo app: crie um usuario proprio (ver docs/SERVIDOR_LINUX.md).
# 127.0.0.1 e nao "localhost": no Linux o Node pode tentar o localhost por IPv6 e o MySQL nao atende la.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=''
DB_NAME=bioshield
DB_PORT=3306

# Porta do BioShield. O site, o app e a API usam a mesma.
PORT=3000

# Segredo que assina o token de login. Troque por um texto longo e so seu.
JWT_SECRET=troque_esse_valor

# Opcional. Endereco pelo qual os celulares enxergam este servidor, e que vai dentro do QR Code.
# Vazio, o servidor descobre sozinho pelo IP da rede. Preencha quando o computador tiver cabo e wifi
# ao mesmo tempo e ele escolher o IP errado. Exemplo: URL_PUBLICA=http://192.168.0.10:3000
URL_PUBLICA=
