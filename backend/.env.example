# Dados do MySQL. No XAMPP o usuario root vem sem senha.
# 127.0.0.1 e nao "localhost": o Node pode tentar o localhost por IPv6 (::1) e o MySQL do XAMPP nao atende la.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=''
DB_NAME=bioshield
DB_PORT=3306

# Porta do BioShield. O site, o app e a API usam a mesma. O Tailscale Funnel aponta para ela.
PORT=3000

# Segredo que assina o token de login. Troque por um texto longo e so seu, de 32 letras ou mais.
# Com o Tailscale Funnel o BioShield fica aberto na internet: o servidor avisa na subida se este valor ficar fraco.
JWT_SECRET=troque_esse_valor

# Endereco pelo qual os celulares enxergam este servidor, e que vai dentro do QR Code.
# Com o Tailscale Funnel (docs/SERVIDOR_ONLINE.md), coloque o endereco que ele mostrou, sem barra no fim e sem porta.
# Exemplo: URL_PUBLICA=https://bioshield.tail1234ab.ts.net
# Vazio, o servidor descobre sozinho pelo IP da rede, e o QR so abre para quem estiver no mesmo wifi.
URL_PUBLICA=
