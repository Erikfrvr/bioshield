POST {{baseUrl}}/medicamentos
Authorization: Bearer {{loginMaria.response.body.token}}
Content-Type: application/json

{
  "idPaciente": 1,
  "nome": "Teste Horario",
  "dosagem": 10,
  "unidade": "mg",
  "frequenciaHoras": 12,
  "horarioInicial": "25:00",
  "dataInicio": "2026-09-28",
  "dataFim": null
}

